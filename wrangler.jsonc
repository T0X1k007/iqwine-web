{
  // Configuration minimale pour MESURER la taille du Worker.
  // Rien n'est déployé : `opennextjs-cloudflare build` produit le paquet en
  // local, et c'est sa taille compressée qui décide du plan nécessaire.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iqwine-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
