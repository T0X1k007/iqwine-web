{
  // Le site iqwine.ai sur Cloudflare : des fichiers statiques (`out/`, cf.
  // `npm run build:cloudflare`) et un Worker minuscule (`cloudflare/worker.ts`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iqwine-web",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  // `process.env` alimenté par les variables et secrets du Worker : c'est ce
  // que lisent `lib/turnstile` et `lib/relais-contact`, partagés avec Vercel.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Les chemins finissant par « / » passent d'abord par le Worker (308).
    "run_worker_first": ["/*/"]
  },
  // La clé IndexNow est PUBLIQUE par conception : le protocole exige qu'elle
  // soit servie en clair à `/<clé>.txt`. Ce n'est pas un secret.
  "vars": { "INDEXNOW_KEY": "a37d27ce1e8e1932e969e104d12c5202" },
  // VALIDATION AVANT BASCULE : l'adresse *.workers.dev sert à tester le Worker
  // avant que la route iqwine.ai/* existe. Les pages y portent la canonical
  // iqwine.ai. À remettre à `false` dans le commit de bascule.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
